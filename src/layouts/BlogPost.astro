---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import '../styles/global.css';

type BlogEntry = CollectionEntry<'blog'>;
type Props = BlogEntry['data'] & {
	nextPost?: BlogEntry | null;
};

const { title, description, pubDate, updatedDate, heroImage, categories, tags, nextPost } =
	Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title} &ndash; joekamprad</title>
	{description && <meta name="description" content={description} />}
	<link rel="icon" href="/favicon.ico" sizes="any" />
</head>
<body>
	<main>
		<nav class="top-nav" aria-label="Post navigation">
			<a href="/">cd ~</a>
			<a href="/blog/">&larr; back to #blog</a>
		</nav>

		<article>
			<header class="post-header">
				<div class="prompt"><span>joe@kamprad.net</span>:~/blog$ cat post.md</div>
				<h1>{title}</h1>
				<div class="meta">
					<span>date: <time datetime={pubDate.toISOString()}>{pubDate.toISOString().slice(0, 10)}</time></span>
					{updatedDate && (
						<span>updated: <time datetime={updatedDate.toISOString()}>{updatedDate.toISOString().slice(0, 10)}</time></span>
					)}
					{categories && categories.length > 0 && (
						<span>cat: {categories.join(', ')}</span>
					)}
				</div>
				{heroImage && (
					<div class="hero">
						<Image src={heroImage} alt={title} />
					</div>
				)}
			</header>

			<div class="prose">
				<slot />
			</div>

			{tags && tags.length > 0 && (
				<div class="tags">
					<span class="dim">tags:</span> {tags.map((t) => `#${t}`).join(' ')}
				</div>
			)}
		</article>

        <script>
            import mediumZoom from 'medium-zoom';
            mediumZoom('article img:not(.active-image)', {
                background: 'rgba(0, 0, 0, 0.85)',
                margin: 24,
            });
        </script>

		<footer class="post-footer">
			<div class="footer-nav-left">
				<a href="/">&larr; home (cd ~)</a>
				<a href="/blog/">&larr; back to #blog</a>
			</div>
			{nextPost && (
				<a class="next-post" href={`/blog/${nextPost.id}/`}>next: {nextPost.data.title} &rarr;</a>
			)}
		</footer>
	</main>

	<style>
		.top-nav {
			display: flex;
			justify-content: space-between;
			gap: 1rem;
			margin-bottom: 2rem;
			font-size: 0.9rem;
		}
		.post-header {
			margin-bottom: 2rem;
			padding-bottom: 1.25rem;
			border-bottom: 1px solid var(--border);
		}
		h1 {
			font-size: clamp(1.4rem, 4vw, 2.1rem);
			line-height: 1.25;
			margin: 0 0 0.75rem 0;
			color: var(--accent);
		}
		.meta {
			display: flex;
			flex-wrap: wrap;
			gap: 1.5ch;
			color: var(--dim);
			font-size: 0.85rem;
		}
		.hero {
			margin-top: 1.25rem;
		}
		.hero :global(img) {
			max-width: 100%;
			height: auto;
			border-radius: 4px;
			border: 1px solid var(--border);
		}
		.tags {
			margin-top: 2rem;
			padding-top: 1rem;
			border-top: 1px dashed var(--border);
			font-size: 0.85rem;
			color: var(--accent);
		}
		.dim {
			color: var(--dim);
		}
		.post-footer {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			align-items: baseline;
			gap: 1rem;
			margin-top: 2.5rem;
			padding-top: 1rem;
			border-top: 1px solid var(--border);
			font-size: 0.9rem;
		}
		.footer-nav-left {
			display: flex;
			gap: 1.5rem;
			flex-shrink: 0;
		}
		.next-post {
			margin-left: auto;
			text-align: right;
		}
	</style>
    <style is:global>
        :root {
            --img-default-width: 320px;
        }

        article img:not(.active-image) {
            width: var(--img-default-width);
            max-width: 100%;
            height: auto;
            border-radius: 6px;
        }
</style>
</body>
</html>