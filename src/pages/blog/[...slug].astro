---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);

	return posts.map((post, index) => {
		// Depending on sort order, index - 1 is newer and index + 1 is older
		const nextPost = index + 1 < posts.length ? posts[index + 1] : null;
		const prevPost = index - 1 >= 0 ? posts[index - 1] : null;

		return {
			params: { slug: post.id },
			props: { post, nextPost, prevPost },
		};
	});
}

const { post, nextPost, prevPost } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} nextPost={nextPost} prevPost={prevPost}>
	<Content />
</BlogPost>