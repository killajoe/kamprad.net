---
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';
import { Image } from 'astro:assets';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [latest, ...older] = posts;
const Content = latest ? (await render(latest)).Content : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>blog &ndash; joekamprad</title>
	<link rel="icon" href="/favicon.ico" sizes="any" />
</head>
<body>
	<main>
		<nav class="top-nav">
			<a href="/">&larr; cd ~</a>
			<a href="/rss.xml">rss.xml</a>
		</nav>

		<div class="prompt"><span>joe@kamprad.net</span>:~/blog$ ls -lt ./posts/</div>
		<h1><em>#blog</em></h1>

{latest && Content && (
	<article class="latest">
		<div class="prompt"><span>joe@kamprad.net</span>:~/blog$ cat ./posts/latest</div>
		<h2><a href={`/blog/${latest.id}/`}>{latest.data.title}</a></h2>
		<time datetime={latest.data.pubDate.toISOString()}>
			{latest.data.pubDate.toISOString().slice(0, 10)}
		</time>
		{latest.data.heroImage && (
			typeof latest.data.heroImage === 'string'
				? <img class="hero" src={latest.data.heroImage} alt="" />
				: <Image class="hero" src={latest.data.heroImage} alt="" />
		)}
		<div class="latest-content prose">
			<Content />
		</div>
	</article>
)}

		{older.length > 0 && (
			<>
				<div class="prompt"><span>joe@kamprad.net</span>:~/blog$ ls ./posts/older/</div>
				<ul class="post-list">
					{older.map((post) => (
						<li>
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toISOString().slice(0, 10)}
							</time>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</li>
					))}
				</ul>
			</>
		)}

		<footer>// {posts.length} entries found.</footer>
	</main>

	<style>
		.top-nav {
			display: flex;
			justify-content: space-between;
			margin-bottom: 2rem;
			font-size: 0.9rem;
		}
		h1 {
			font-size: clamp(1.5rem, 4vw, 2.2rem);
			margin: 0 0 1.75rem 0;
		}
		h1 em {
			color: var(--accent);
			font-style: normal;
		}
		.latest {
			margin-bottom: 3rem;
			padding-bottom: 2rem;
			border-bottom: 1px dashed var(--border);
		}
		.latest h2 {
			margin: 0.5rem 0 0.25rem 0;
		}
		.latest-content {
			margin-top: 1.25rem;
		}
		/* Inhalte aus <Content /> bekommen kein Scoping, daher :global */
		.latest-content :global(img),
		.latest-content :global(iframe),
		.latest-content :global(video) {
			max-width: 100%;
		}
		.post-list {
			list-style: none;
			padding: 0;
			margin: 0;
		}
		.post-list li {
			display: flex;
			gap: 1.5ch;
			padding: 0.45rem 0;
			border-bottom: 1px dashed var(--border);
			align-items: baseline;
		}
		time {
			color: var(--dim);
			font-size: 0.9rem;
			flex-shrink: 0;
		}
		footer {
			margin-top: 2.5rem;
			color: var(--dim);
			font-size: 0.85rem;
		}
	</style>
</body>
</html>
