---
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>joekamprad</title>
	<meta name="description" content="This is the new home for joekamprad – EndeavourOS, sway, hardware/food hacking" />
	<link rel="icon" href="/favicon.ico" sizes="any" />
</head>
<body>
	<main>
		<img class="avatar" src="/images/joegta6.png" alt="joekamprad" width="140" height="140" />
		<div class="prompt"><span>joe@kamprad.net</span>:~$ cat welcome.txt</div>
		<h1>This is the new home for <em>joekamprad</em><span class="cursor"></span></h1>

		<div class="info">
			<div class="row"><span class="k">whoami</span><span class="v"><b>joekamprad</b> &ndash; Der Doktor</span></div>
			<div class="row"><span class="k">working</span><span class="v">on EndeavourOS, all the time</span></div>
			<div class="row"><span class="k">projects</span><span class="v">EndeavourOS, sway, hardware/food hacking</span></div>
		</div>

		<nav class="links" aria-label="Primary navigation">
			<div class="prompt"><span>joe@kamprad.net</span>:~$ ls -la ./</div>
			<ul>
				<li><a href="/blog/">#blog</a> <span class="desc">&ndash; notes, tutorials &amp; rants</span></li>
				<li><a href="https://endeavouros.com" target="_blank" rel="noopener">#endeavouros.com</a> <span class="desc">&ndash; purple space linux distro</span></li>
				<li><a href="https://github.com/killajoe" target="_blank" rel="noopener">#git</a> <span class="desc">&ndash; code &amp; dotfiles</span></li>
			</ul>
		</nav>

		{latestPosts.length > 0 && (
			<section class="recent">
				<div class="prompt"><span>joe@kamprad.net</span>:~$ head -n 3 ./blog/index.log</div>
				<ul>
					{latestPosts.map((post) => (
						<li>
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toISOString().slice(0, 10)}
							</time>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</li>
					))}
				</ul>
			</section>
		)}

        <footer>// server online.  <a href="/about">about.</a> <a href="/privacy">privacy.</a></footer>
	</main>

	<style>
		:root {
			--bg: #0b0d12;
			--fg: #d7dae0;
			--accent: #7f7fff;
			--dim: #5b6070;
		}
		@media (prefers-color-scheme: light) {
			:root {
				--bg: #f4f5f8;
				--fg: #1c1e26;
				--accent: #5a4fcf;
				--dim: #8a8fa0;
			}
		}
		* {
			box-sizing: border-box;
		}
		html,
		body {
			min-height: 100%;
			margin: 0;
		}
		body {
			background: var(--bg);
			color: var(--fg);
			font-family: ui-monospace, "JetBrains Mono", "Fira Code", Menlo, Consolas, monospace;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 2rem 1.5rem;
			background-image: radial-gradient(circle at 50% 40%, rgba(127, 127, 255, 0.12), transparent 60%);
		}
		main {
			max-width: 42rem;
			width: 100%;
		}
		.prompt {
			color: var(--dim);
			font-size: 0.95rem;
			margin-bottom: 0.6rem;
		}
		.prompt span {
			color: var(--accent);
		}
		h1 {
			font-size: clamp(1.4rem, 4.5vw, 2.4rem);
			font-weight: 600;
			line-height: 1.3;
			margin: 0;
		}
		h1 em {
			color: var(--accent);
			font-style: normal;
		}
		.cursor {
			display: inline-block;
			width: 0.6ch;
			height: 1em;
			background: var(--accent);
			vertical-align: -0.12em;
			margin-left: 0.2ch;
			animation: blink 1.1s steps(1) infinite;
		}
		@keyframes blink {
			50% {
				opacity: 0;
			}
		}
		.avatar {
			display: block;
			width: 140px;
			height: 140px;
			border-radius: 50%;
			object-fit: cover;
			margin-bottom: 1.75rem;
			border: 2px solid var(--accent);
			box-shadow: 0 0 0 5px var(--bg), 0 0 40px rgba(127, 127, 255, 0.35);
		}
		.info {
			margin-top: 1.75rem;
			font-size: 0.95rem;
			line-height: 1.7;
		}
		.info .row {
			display: flex;
			gap: 1ch;
			flex-wrap: wrap;
		}
		.info .k {
			color: var(--dim);
			min-width: 9ch;
		}
		.info .v {
			color: var(--fg);
		}
		.info .v b {
			color: var(--accent);
			font-weight: 600;
		}
		.links,
		.recent {
			margin-top: 2rem;
			font-size: 0.95rem;
		}
		ul {
			list-style: none;
			padding: 0;
			margin: 0;
			line-height: 1.8;
		}
		.links li {
			display: flex;
			gap: 1.2ch;
			flex-wrap: wrap;
		}
		.recent li {
			display: flex;
			align-items: baseline;
			gap: 1.5ch;
			flex-wrap: nowrap;
		}
		.recent time {
			flex: 0 0 10ch;
			color: var(--dim);
		}
		.recent a {
			flex: 1 1 auto;
			min-width: 0;
			overflow-wrap: anywhere;
		}
		a {
			color: var(--accent);
			text-decoration: none;
			border-bottom: 1px solid transparent;
		}
		a:hover,
		a:focus-visible {
			border-bottom-color: var(--accent);
		}
		.desc,
		time {
			color: var(--dim);
		}
		footer {
			margin-top: 2.25rem;
			color: var(--dim);
			font-size: 0.85rem;
		}
		footer a {
			color: var(--dim);
		}
		footer a:hover {
			color: var(--accent);
		}
		@media (max-width: 480px) {
			.recent li {
				flex-wrap: wrap;
				gap: 0.25rem;
				margin-bottom: 0.5rem;
			}
			.recent time {
				flex: 0 0 100%;
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.cursor {
				animation: none;
			}
		}
	</style>
</body>
</html>